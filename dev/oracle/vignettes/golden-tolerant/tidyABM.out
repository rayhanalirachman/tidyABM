function () 
{
    m <- abm_setup(agents = abm_agents(n = 50, x = ~runif(n)), 
        seed = 4)
    noop_go <- abm_go(abm_rules(x ~ x))
    abm_run(m, noop_go, ticks = 1, seed = 5)
}
